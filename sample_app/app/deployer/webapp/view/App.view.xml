<mvc:View
  controllerName="cpideployer.sample.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:u="sap.ui.unified"
  xmlns:f="sap.ui.layout.form"
>
  <Shell>
    <App>
      <Page title="{i18n>appTitle}">
        <content>
          <VBox class="sapUiMediumMargin" width="auto">

            <Panel headerText="{i18n>jobHistoryHeader}" class="sapUiResponsiveMargin" expandable="true" expanded="false">
              <content>
                <VBox class="sapUiSmallMarginTop">
                  <Button
                    id="refreshJobsButton"
                    text="{i18n>refreshJobsButtonText}"
                    press="onRefreshJobsPress"
                  />

                  <Table
                    id="jobsTable"
                    class="sapUiSmallMarginTop"
                    items="{jobs>/list}"
                    noDataText="{i18n>noJobsYet}"
                  >
                    <columns>
                      <Column><Text text="{i18n>colArtifactId}" /></Column>
                      <Column><Text text="{i18n>colSource}" /></Column>
                      <Column><Text text="{i18n>colResult}" /></Column>
                      <Column><Text text="{i18n>colAttempt}" /></Column>
                      <Column><Text text="{i18n>colUpdatedAt}" /></Column>
                      <Column></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{jobs>id}" />
                          <Text text="{jobs>source}" />
                          <ObjectStatus text="{jobs>status}" />
                          <Text text="{jobs>attemptCount}" />
                          <Text text="{jobs>updatedAt}" />
                          <Button text="{i18n>selectJobButtonText}" press="onSelectJobPress" />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </content>
            </Panel>

            <Panel headerText="{i18n>stepDetailsHeader}" class="sapUiResponsiveMargin">
              <content>
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                  <Label text="{i18n>artifactIdLabel}" />
                  <Input id="artifactIdInput" placeholder="{i18n>artifactIdPlaceholder}" />

                  <Label text="{i18n>artifactNameLabel}" />
                  <Input id="artifactNameInput" placeholder="{i18n>artifactNamePlaceholder}" />

                  <Label text="{i18n>packageIdLabel}" />
                  <Input id="packageIdInput" placeholder="{i18n>packageIdPlaceholder}" />
                </f:SimpleForm>
              </content>
            </Panel>

            <Panel headerText="{i18n>stepDescriptionHeader}" class="sapUiResponsiveMargin">
              <content>
                <TextArea
                  id="descriptionInput"
                  placeholder="{i18n>descriptionPlaceholder}"
                  rows="3"
                  width="100%"
                  liveChange="onDescriptionChange"
                />
              </content>
            </Panel>

            <Panel headerText="{i18n>stepDeployHeader}" class="sapUiResponsiveMargin">
              <content>
                <VBox class="sapUiSmallMarginTop">
                  <HBox>
                    <Button
                      id="deployButton"
                      text="{i18n>deployButtonText}"
                      type="Emphasized"
                      enabled="false"
                      press="onGenerateAndDeployPress"
                    />
                    <Button
                      id="fixButton"
                      text="{i18n>fixButtonText}"
                      type="Attention"
                      visible="false"
                      class="sapUiTinyMarginBegin"
                      press="onFixAndRedeployPress"
                    />
                  </HBox>

                  <HBox class="sapUiSmallMarginTop" alignItems="Center">
                    <BusyIndicator id="statusBusy" visible="false" size="1rem" class="sapUiTinyMarginEnd" />
                    <ObjectStatus id="statusText" text="{i18n>statusInitial}" state="None" />
                  </HBox>

                  <MessageStrip
                    id="errorStrip"
                    visible="false"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop"
                  />

                  <MessageStrip
                    id="maxAttemptsStrip"
                    visible="false"
                    type="Warning"
                    showIcon="true"
                    text="{i18n>maxAttemptsReached}"
                    class="sapUiSmallMarginTop"
                  />

                  <Table
                    id="attemptsTable"
                    class="sapUiSmallMarginTop"
                    items="{attempts>/list}"
                    noDataText="{i18n>noAttemptsYet}"
                  >
                    <columns>
                      <Column><Text text="{i18n>colAttempt}" /></Column>
                      <Column><Text text="{i18n>colResult}" /></Column>
                      <Column><Text text="{i18n>colSummary}" /></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{attempts>attemptNumber}" />
                          <ObjectStatus text="{attempts>status}" state="{attempts>statusState}" />
                          <Text text="{attempts>summary}" />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </content>
            </Panel>

            <Panel headerText="{i18n>stepZipHeader}" class="sapUiResponsiveMargin" expandable="true" expanded="false">
              <content>
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                  <Label text="{i18n>artifactIdLabel}" />
                  <Input id="zipArtifactIdInput" placeholder="{i18n>artifactIdPlaceholder}" />

                  <Label text="{i18n>artifactNameLabel}" />
                  <Input id="zipArtifactNameInput" placeholder="{i18n>artifactNamePlaceholder}" />

                  <Label text="{i18n>packageIdLabel}" />
                  <Input id="zipPackageIdInput" placeholder="{i18n>packageIdPlaceholder}" />
                </f:SimpleForm>

                <u:FileUploader
                  id="zipFileUploader"
                  name="iflowZip"
                  fileType="zip"
                  placeholder="{i18n>filePickerPlaceholder}"
                  change="onZipFileChange"
                  width="100%"
                />

                <TextArea
                  id="zipDescriptionInput"
                  placeholder="{i18n>zipDescriptionPlaceholder}"
                  rows="2"
                  width="100%"
                  class="sapUiSmallMarginTop"
                />

                <Button
                  id="deployZipButton"
                  text="{i18n>deployZipButtonText}"
                  type="Emphasized"
                  enabled="false"
                  class="sapUiSmallMarginTop"
                  press="onDeployZipPress"
                />
              </content>
            </Panel>

            <Panel headerText="{i18n>stepManualHeader}" class="sapUiResponsiveMargin" expandable="true" expanded="false">
              <content>
                <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                  <Label text="{i18n>artifactIdLabel}" />
                  <Input id="manualArtifactIdInput" placeholder="{i18n>artifactIdPlaceholder}" />

                  <Label text="{i18n>artifactNameLabel}" />
                  <Input id="manualArtifactNameInput" placeholder="{i18n>artifactNamePlaceholder}" />

                  <Label text="{i18n>packageIdLabel}" />
                  <Input id="manualPackageIdInput" placeholder="{i18n>packageIdPlaceholder}" />
                </f:SimpleForm>

                <TextArea
                  id="manualDescriptionInput"
                  placeholder="{i18n>manualDescriptionPlaceholder}"
                  rows="2"
                  width="100%"
                />

                <Button
                  id="addManualJobButton"
                  text="{i18n>addManualJobButtonText}"
                  type="Emphasized"
                  class="sapUiSmallMarginTop"
                  press="onAddManualJobPress"
                />
              </content>
            </Panel>

            <Panel headerText="{i18n>stepErrorsHeader}" class="sapUiResponsiveMargin">
              <content>
                <VBox class="sapUiSmallMarginTop">
                  <Button
                    id="checkErrorsButton"
                    text="{i18n>checkErrorsButtonText}"
                    press="onCheckErrorsPress"
                  />

                  <Table
                    id="errorTable"
                    class="sapUiSmallMarginTop"
                    items="{errors>/artifacts}"
                    noDataText="{i18n>noErrorArtifacts}"
                  >
                    <columns>
                      <Column><Text text="{i18n>colArtifactId}" /></Column>
                      <Column><Text text="{i18n>colDeployedOn}" /></Column>
                      <Column></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{errors>Id}" />
                          <Text text="{errors>DeployedOn}" />
                          <Button text="{i18n>viewErrorButtonText}" press="onViewErrorPress" />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>

                  <MessageStrip
                    id="errorDetailStrip"
                    visible="false"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop"
                  />
                </VBox>
              </content>
            </Panel>

          </VBox>
        </content>
      </Page>
    </App>
  </Shell>
</mvc:View>
