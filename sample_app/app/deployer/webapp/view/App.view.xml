<mvc:View
  controllerName="cpideployer.sample.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:u="sap.ui.unified"
  xmlns:f="sap.ui.layout.form"
>
  <Shell appWidthLimited="false">
    <App>
      <Page title="{i18n>appTitle}" class="sapUiResponsiveContentPadding">
        <content>

          <VBox class="sapUiSmallMarginBottom">
            <Text text="{i18n>appDescription}" class="sapUiTinyMarginBottom" />
          </VBox>

          <IconTabBar
            id="iconTabBar"
            headerMode="Inline"
            expandable="false"
            class="sapUiResponsiveContentPadding appTabBar"
          >
            <items>

              <IconTabFilter key="generate" text="{i18n>tabGenerate}">
                <VBox>
                  <Panel headerText="{i18n>stepDetailsHeader}" class="sapUiResponsiveMargin">
                    <content>
                      <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                        <Label text="{i18n>artifactIdLabel}" />
                        <Input id="artifactIdInput" placeholder="{i18n>artifactIdPlaceholder}" />

                        <Label text="{i18n>artifactNameLabel}" />
                        <Input id="artifactNameInput" placeholder="{i18n>artifactNamePlaceholder}" />

                        <Label text="{i18n>packageIdLabel}" />
                        <Input id="packageIdInput" value="cpipackage" placeholder="{i18n>packageIdPlaceholder}" />
                      </f:SimpleForm>
                    </content>
                  </Panel>

                  <Panel headerText="{i18n>stepDescriptionHeader}" class="sapUiResponsiveMargin">
                    <content>
                      <TextArea
                        id="descriptionInput"
                        placeholder="{i18n>descriptionPlaceholder}"
                        rows="3"
                        width="100%"
                        liveChange="onDescriptionChange"
                      />
                    </content>
                  </Panel>

                  <Panel headerText="{i18n>stepDeployHeader}" class="sapUiResponsiveMargin">
                    <content>
                      <VBox class="sapUiSmallMarginTop">
                        <HBox>
                          <Button
                            id="deployButton"
                            text="{i18n>deployButtonText}"
                            type="Emphasized"
                            enabled="false"
                            press="onGenerateAndDeployPress"
                          />
                          <Button
                            id="fixButton"
                            text="{i18n>fixButtonText}"
                            type="Attention"
                            visible="false"
                            class="sapUiTinyMarginBegin"
                            press="onFixAndRedeployPress"
                          />
                        </HBox>

                        <HBox class="sapUiSmallMarginTop" alignItems="Center">
                          <BusyIndicator id="statusBusy" visible="false" size="1rem" class="sapUiTinyMarginEnd" />
                          <ObjectStatus id="statusText" text="{i18n>statusInitial}" state="None" />
                        </HBox>

                        <MessageStrip
                          id="errorStrip"
                          visible="false"
                          type="Error"
                          showIcon="true"
                          class="sapUiSmallMarginTop"
                        />

                        <MessageStrip
                          id="maxAttemptsStrip"
                          visible="false"
                          type="Warning"
                          showIcon="true"
                          text="{i18n>maxAttemptsReached}"
                          class="sapUiSmallMarginTop"
                        />

                        <Table
                          id="attemptsTable"
                          class="sapUiSmallMarginTop"
                          items="{attempts>/list}"
                          noDataText="{i18n>noAttemptsYet}"
                        >
                          <columns>
                            <Column><Text text="{i18n>colAttempt}" /></Column>
                            <Column><Text text="{i18n>colResult}" /></Column>
                            <Column><Text text="{i18n>colSummary}" /></Column>
                            <Column><Text text="{i18n>colDownload}" /></Column>
                          </columns>
                          <items>
                            <ColumnListItem>
                              <cells>
                                <Text text="{attempts>attemptNumber}" />
                                <ObjectStatus text="{attempts>status}" state="{attempts>statusState}" />
                                <Button
                                  text="{i18n>showSummaryButtonText}"
                                  type="Transparent"
                                  press="onShowSummaryPress"
                                />
                                <Button
                                  icon="sap-icon://download"
                                  type="Transparent"
                                  text="{i18n>downloadButtonText}"
                                  visible="{attempts>hasZip}"
                                  press="onDownloadZipPress"
                                />
                              </cells>
                            </ColumnListItem>
                          </items>
                        </Table>
                      </VBox>
                    </content>
                  </Panel>
                </VBox>
              </IconTabFilter>

              <IconTabFilter key="zip" text="{i18n>tabZip}">
                <VBox class="sapUiSmallMarginTop">
                  <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
                    <Label text="{i18n>artifactIdLabel}" />
                    <Input id="zipArtifactIdInput" placeholder="{i18n>artifactIdPlaceholder}" />

                    <Label text="{i18n>artifactNameLabel}" />
                    <Input id="zipArtifactNameInput" placeholder="{i18n>artifactNamePlaceholder}" />

                    <Label text="{i18n>packageIdLabel}" />
                    <Input id="zipPackageIdInput" value="cpipackage" placeholder="{i18n>packageIdPlaceholder}" />
                  </f:SimpleForm>

                  <u:FileUploader
                    id="zipFileUploader"
                    name="iflowZip"
                    fileType="zip"
                    placeholder="{i18n>filePickerPlaceholder}"
                    change="onZipFileChange"
                    width="100%"
                  />

                  <TextArea
                    id="zipDescriptionInput"
                    placeholder="{i18n>zipDescriptionPlaceholder}"
                    rows="2"
                    width="100%"
                    class="sapUiSmallMarginTop"
                  />

                  <HBox class="sapUiSmallMarginTop">
                    <Button
                      id="deployZipButton"
                      text="{i18n>deployZipButtonText}"
                      type="Emphasized"
                      enabled="false"
                      press="onDeployZipPress"
                    />
                    <Button
                      id="zipFixButton"
                      text="{i18n>fixButtonText}"
                      type="Attention"
                      visible="false"
                      class="sapUiTinyMarginBegin"
                      press="onFixAndRedeployPress"
                    />
                  </HBox>

                  <HBox class="sapUiSmallMarginTop" alignItems="Center">
                    <BusyIndicator id="zipStatusBusy" visible="false" size="1rem" class="sapUiTinyMarginEnd" />
                    <ObjectStatus id="zipStatusText" text="{i18n>statusInitial}" state="None" />
                  </HBox>

                  <MessageStrip
                    id="zipErrorStrip"
                    visible="false"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginTop"
                  />

                  <MessageStrip
                    id="zipMaxAttemptsStrip"
                    visible="false"
                    type="Warning"
                    showIcon="true"
                    text="{i18n>maxAttemptsReached}"
                    class="sapUiSmallMarginTop"
                  />

                  <Table
                    id="zipAttemptsTable"
                    class="sapUiSmallMarginTop"
                    items="{attempts>/list}"
                    noDataText="{i18n>noAttemptsYet}"
                  >
                    <columns>
                      <Column><Text text="{i18n>colAttempt}" /></Column>
                      <Column><Text text="{i18n>colResult}" /></Column>
                      <Column><Text text="{i18n>colSummary}" /></Column>
                      <Column><Text text="{i18n>colDownload}" /></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{attempts>attemptNumber}" />
                          <ObjectStatus text="{attempts>status}" state="{attempts>statusState}" />
                          <Button
                            text="{i18n>showSummaryButtonText}"
                            type="Transparent"
                            press="onShowSummaryPress"
                          />
                          <Button
                            icon="sap-icon://download"
                            type="Transparent"
                            text="{i18n>downloadButtonText}"
                            visible="{attempts>hasZip}"
                            press="onDownloadZipPress"
                          />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </IconTabFilter>

              <IconTabFilter key="errors" text="{i18n>tabErrors}">
                <VBox class="sapUiSmallMarginTop">
                  <Button
                    id="checkErrorsButton"
                    text="{i18n>checkErrorsButtonText}"
                    press="onCheckErrorsPress"
                  />

                  <Table
                    id="errorTable"
                    class="sapUiSmallMarginTop"
                    items="{errors>/artifacts}"
                    noDataText="{i18n>noErrorArtifacts}"
                  >
                    <columns>
                      <Column><Text text="{i18n>colArtifactId}" /></Column>
                      <Column><Text text="{i18n>colDeployedOn}" /></Column>
                      <Column></Column>
                      <Column></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{errors>Id}" />
                          <Text text="{errors>DeployedOn}" />
                          <Button text="{i18n>viewErrorButtonText}" type="Transparent" press="onViewErrorPress" />
                          <Button text="{i18n>fixButtonText}" type="Attention" press="onFixBrokenFlowPress" />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </IconTabFilter>

              <IconTabFilter key="history" text="{i18n>tabJobHistory}">
                <VBox class="sapUiSmallMarginTop">
                  <Button
                    id="refreshJobsButton"
                    text="{i18n>refreshJobsButtonText}"
                    press="onRefreshJobsPress"
                  />

                  <Table
                    id="jobsTable"
                    class="sapUiSmallMarginTop"
                    items="{jobs>/list}"
                    noDataText="{i18n>noJobsYet}"
                  >
                    <columns>
                      <Column><Text text="{i18n>colArtifactId}" /></Column>
                      <Column><Text text="{i18n>colSource}" /></Column>
                      <Column><Text text="{i18n>colResult}" /></Column>
                      <Column><Text text="{i18n>colAttempt}" /></Column>
                      <Column><Text text="{i18n>colUpdatedAt}" /></Column>
                      <Column></Column>
                    </columns>
                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{jobs>id}" />
                          <Text text="{jobs>source}" />
                          <ObjectStatus text="{jobs>status}" />
                          <Text text="{jobs>attemptCount}" />
                          <Text text="{jobs>updatedAt}" />
                          <Button text="{i18n>selectJobButtonText}" press="onSelectJobPress" />
                        </cells>
                      </ColumnListItem>
                    </items>
                  </Table>
                </VBox>
              </IconTabFilter>

            </items>
          </IconTabBar>

        </content>
      </Page>
    </App>
  </Shell>

  <Dialog
    id="fixRedeployDialog"
    title="{i18n>fixDialogTitle}"
    contentWidth="28rem"
  >
    <content>
      <VBox class="sapUiSmallMargin">
        <Text id="fixDialogIntro" class="sapUiSmallMarginBottom" />

        <f:SimpleForm id="fixDialogForm" editable="true" layout="ResponsiveGridLayout">
          <Label text="{i18n>packageIdLabel}" />
          <Input id="fixDialogPackageIdInput" placeholder="{i18n>packageIdPlaceholder}" />

          <Label text="{i18n>stepDescriptionHeader}" />
          <TextArea id="fixDialogDescriptionInput" rows="3" width="100%" placeholder="{i18n>descriptionPlaceholder}" />
        </f:SimpleForm>

        <HBox class="sapUiSmallMarginTop" alignItems="Center">
          <BusyIndicator id="fixDialogBusy" visible="false" size="1rem" class="sapUiTinyMarginEnd" />
          <ObjectStatus id="fixDialogStatusText" text="" state="None" />
        </HBox>

        <MessageStrip
          id="fixDialogErrorStrip"
          visible="false"
          type="Error"
          showIcon="true"
          class="sapUiSmallMarginTop"
        />
      </VBox>
    </content>
    <beginButton>
      <Button id="fixDialogConfirmButton" text="{i18n>fixButtonText}" type="Emphasized" press="onConfirmFixRedeploy" />
    </beginButton>
    <endButton>
      <Button text="{i18n>closeButtonText}" press="onCloseFixDialog" />
    </endButton>
  </Dialog>

</mvc:View>
