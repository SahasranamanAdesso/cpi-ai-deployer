# Local fallback credentials for @david10ten/deployer, used when VCAP_SERVICES
# has no bound "cpi-ai-platform-api" (it-rt) instance - i.e. when running with
# `cds watch` locally instead of on Cloud Foundry. Get these from the service
# key of your CPI Integration Runtime (it-rt, plan "api") service instance.
CPI_CLIENT_ID=
CPI_CLIENT_SECRET=
CPI_TOKEN_URL=
CPI_API_BASE_URL=

# AI provider for @cpi-ai/compiler's generation (Generate & Deploy / Fix &
# Redeploy). Set ONE of the two options below - AI_HUB_API_KEY is checked
# first and takes priority if both are set.

# Option 1 (preferred): adesso AI Hub - OpenAI-compatible chat completions
# endpoint. AI_HUB_API_URL/AI_HUB_MODEL are optional overrides; defaults are
# https://adesso-ai-hub.3asabc.de/v1/chat/completions and
# deepseek-v4-flash-sovereign.
AI_HUB_API_KEY=
AI_HUB_API_URL=
AI_HUB_MODEL=

# Option 2 (fallback): a DIRECT Anthropic API key from console.anthropic.com.
# A Claude Code session key will NOT work here, since ClaudeProvider calls
# api.anthropic.com directly rather than going through any proxy.
ANTHROPIC_API_KEY=
